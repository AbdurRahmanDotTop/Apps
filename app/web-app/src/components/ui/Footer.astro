---
import { env } from "cloudflare:workers";

let settings = {
  site_name: "Techily Fly Apps",
  social_links: "[]"
};
let socialLinks = [];

try {
  const db = env.DB;
  if (db) {
    const result = await db.prepare(`SELECT site_name, social_links FROM website_settings LIMIT 1`).first();
    if (result) {
      settings.site_name = result.site_name || "Techily Fly Apps";
      if (result.social_links) {
        socialLinks = JSON.parse(result.social_links);
      }
    }
  }
} catch (e) {
  console.error("Failed to fetch settings for footer", e);
}
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <h3>{settings.site_name}</h3>
        <p>Premium mobile and web applications tailored for your needs.</p>
      </div>
      <div class="footer-socials">
        {socialLinks.length > 0 ? (
          socialLinks.map((link: any) => {
            const iconStr = (link.icon || '').trim();
            const isRawHtml = iconStr.startsWith('<');
            const isFullAnchor = isRawHtml && iconStr.toLowerCase().startsWith('<a');
            
            if (isFullAnchor) {
              return <Fragment set:html={iconStr} />;
            }
            
            return (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-icon" title={link.name}>
                {isRawHtml ? (
                  <Fragment set:html={iconStr} />
                ) : iconStr.startsWith('http') || iconStr.startsWith('/') ? (
                  <img src={iconStr} alt={link.name} class="social-img-icon" />
                ) : (
                  <i class={iconStr}></i>
                )}
              </a>
            );
          })
        ) : null}
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {settings.site_name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--apple-dark, #1d1d1f);
    color: #f5f5f7;
    padding: 3rem 1rem 1rem;
    margin-top: 4rem;
  }
  
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .footer-brand h3 {
    color: #fff;
    margin-bottom: 0.5rem;
  }
  
  .footer-brand p {
    color: #a1a1a6;
    max-width: 400px;
  }
  
  .footer-socials {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.1);
    color: #fff;
    font-size: 1.25rem;
    text-decoration: none;
    transition: background-color 0.2s, transform 0.2s;
  }
  
  .social-icon:hover {
    background-color: var(--signal-coral, #ff4d4d);
    transform: translateY(-2px);
  }

  .social-img-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  
  .footer-bottom {
    text-align: center;
    color: #a1a1a6;
    font-size: 0.9rem;
  }
</style>
