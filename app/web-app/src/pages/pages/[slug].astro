---
import PublicLayout from '../../layouts/PublicLayout.astro';

const { slug } = Astro.params;

const titles: Record<string, string> = {
    'privacy-policy': 'Privacy Policy',
    'terms-conditions': 'Terms & Conditions',
    'refund-policy': 'Refund Policy',
    'faq': 'Frequently Asked Questions',
    'pricing': 'Pricing Plans'
};

const title = titles[slug as string] ?? 'Page Under Construction';

// If the slug isn't in our allowed list, we could return a 404, but to mimic legacy behavior we show "Under Construction".
if (!titles[slug as string] && slug !== 'coming-soon') {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}
---

<PublicLayout title={title}>
  <section class="section">
    <div class="container" style="text-align: center; max-width: 600px; margin: 4rem auto;">
      <div style="font-size: 5rem; color: var(--signal-coral); margin-bottom: 20px;">
        📄
      </div>
      <h1 style="margin-bottom: 20px; font-size: 2.5rem;">{title}</h1>
      <p style="color: rgba(33, 33, 33, 0.7); line-height: 1.8; font-size: 1.1rem;">
        This page is currently being updated. Please check back later for the latest information.
      </p>
      <div style="margin-top: 30px;">
        <a href="/" class="btn btn-primary" style="display: inline-block; padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 4px; font-weight: 600;">Return to Home</a>
      </div>
    </div>
  </section>
</PublicLayout>
