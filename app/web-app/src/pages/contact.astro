---
import PublicLayout from '../layouts/PublicLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { env } from "cloudflare:workers";

let successMsg = '';
let errorMsg = '';
const db = env.DB;

// Handle Form Submission
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = data.get('name')?.toString().trim();
    const email = data.get('email')?.toString().trim();
    const subject = data.get('subject')?.toString().trim();
    const message = data.get('message')?.toString().trim();

    if (!name || !email || !subject || !message) {
      errorMsg = 'Please fill out all fields.';
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorMsg = 'Invalid email format.';
    } else {
      const stmt = db.prepare(`
        INSERT INTO contact_messages (name, email, subject, message, status, created_at)
        VALUES (?, ?, ?, ?, 'unread', CURRENT_TIMESTAMP)
      `);
      await stmt.bind(name, email, subject, message).run();
      successMsg = 'Thank you for reaching out! Your message has been sent successfully.';
    }
  } catch (err: any) {
    errorMsg = 'Something went wrong. Please try again later.';
    console.error('Contact error:', err);
  }
}

// Fetch Contact Settings
let settings = { contact_email: '', contact_phone: '', contact_address: '' };
try {
  const result = await db.prepare("SELECT * FROM website_settings LIMIT 1").first();
  if (result) settings = result as any;
} catch (err) {
  console.error("Failed to load settings", err);
}
---

<PublicLayout title="Contact Us">
  <div class="contact-container">
    <div class="contact-info">
      <h1>Contact Us</h1>
      <p>Have a question or need assistance? Fill out the form and our team will get back to you shortly.</p>
      
      <div class="info-items">
        {settings.contact_email && (
          <div class="info-item">
            <strong>Email:</strong> {settings.contact_email}
          </div>
        )}
        {settings.contact_phone && (
          <div class="info-item">
            <strong>Phone:</strong> {settings.contact_phone}
          </div>
        )}
        {settings.contact_address && (
          <div class="info-item">
            <strong>Address:</strong> {settings.contact_address}
          </div>
        )}
      </div>
    </div>

    <div class="contact-form-wrapper">
      <Card>
        {successMsg && <div class="alert alert-success">{successMsg}</div>}
        {errorMsg && <div class="alert alert-error">{errorMsg}</div>}

        <form class="contact-form" method="POST">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required />
          </div>
          
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          
          <Button type="submit" variant="primary" class="submit-btn">Send Message</Button>
        </form>
      </Card>
    </div>
  </div>
</PublicLayout>

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
    padding: 3rem 1.5rem;
    max-width: 1100px;
    margin: 2rem auto;
    background-color: transparent;
  }
  
  .contact-info {
    padding-top: 1rem;
  }
  
  .contact-info h1 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--tf-graphite);
  }
  
  .contact-info p {
    font-size: 1.125rem;
    color: rgba(33, 33, 33, 0.6);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }
  
  .info-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background-color: var(--apple-gray);
    border-radius: var(--border-radius-md);
  }
  
  .info-item {
    font-size: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .info-item strong {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(33, 33, 33, 0.5);
  }
  
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-group label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--tf-graphite);
  }
  
  .form-group input, .form-group textarea {
    padding: 0.875rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-brand);
    font-size: 1rem;
    outline: none;
    background-color: var(--apple-gray);
    color: inherit;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  
  .form-group input:focus, .form-group textarea:focus {
    border-color: var(--signal-coral);
    background-color: #fff;
    box-shadow: 0 0 0 3px rgba(255, 119, 89, 0.1);
  }
  
  .submit-btn {
    margin-top: 1rem;
    width: 100%;
    padding: 1rem !important;
    font-size: 1.05rem !important;
  }

  .alert {
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius-sm);
    margin-bottom: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  
  .alert-success {
    background-color: rgba(16, 185, 129, 0.1);
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }
  
  .alert-error {
    background-color: rgba(239, 68, 68, 0.1);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  @media (max-width: 900px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 2rem 1rem;
    }
    
    .contact-info h1 {
      font-size: 2.5rem;
    }
  }
</style>
