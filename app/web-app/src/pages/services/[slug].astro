---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Button from '../../components/ui/Button.astro';
import { env } from "cloudflare:workers";

const db = env.DB;
const { slug } = Astro.params;

let service: any = null;

try {
  service = await db.prepare("SELECT * FROM services WHERE slug = ? AND status = 'active'").bind(slug).first();
} catch (e) {
  console.error("Failed to fetch service details", e);
}

if (!service) {
  return Astro.redirect('/404');
}

const decodeHtml = (html: string) => {
  if (!html) return '';
  return String(html).replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
};
---

<PublicLayout title={`${service.name} | Techily Fly`} description={service.description ? decodeHtml(service.description).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 160) : ''}>
  <!-- Service Header -->
  <section class="service-header-section">
    <div class="container text-center">
      <div class="service-icon-large">
        <i class={`bx ${service.icon || 'bx-layer'}`}></i>
      </div>
      <h1 class="service-title">{service.name}</h1>
      <p class="service-subtitle">{service.description ? decodeHtml(service.description).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() : ''}</p>
    </div>
  </section>

  <!-- Service Content -->
  <section class="service-content-section">
    <div class="container">
      <div class="service-content-box" set:html={decodeHtml(service.content) || "<p>Detailed information about this service is currently being updated.</p>"} />
      
      <div class="service-cta">
        <h3>Interested in {service.name}?</h3>
        <p>Let's discuss how we can help your business grow with our professional services.</p>
        <Button href="/contact" variant="primary">Get a Quote</Button>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .service-header-section {
    padding: 6rem 0 4rem;
    background: linear-gradient(180deg, rgba(245, 245, 247, 0.5) 0%, rgba(255,255,255,0) 100%);
  }

  .service-icon-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(255, 51, 51, 0.1);
    color: var(--signal-coral);
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .service-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--tf-graphite), #555);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .service-subtitle {
    font-size: 1.25rem;
    color: rgba(33, 33, 33, 0.7);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .service-content-section {
    padding: 2rem 0 6rem;
  }

  .service-content-box {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    padding: 3rem;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    line-height: 1.8;
    color: var(--tf-graphite);
    font-size: 1.125rem;
  }

  .service-content-box :global(h2) {
    font-size: 1.75rem;
    margin: 2rem 0 1rem;
    color: #000;
  }

  .service-content-box :global(p) {
    margin-bottom: 1.25rem;
  }

  .service-cta {
    max-width: 800px;
    margin: 4rem auto 0;
    text-align: center;
    background: var(--apple-gray);
    padding: 3rem;
    border-radius: 16px;
  }

  .service-cta h3 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .service-cta p {
    color: rgba(33, 33, 33, 0.7);
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }

  @media (max-width: 768px) {
    .service-title {
      font-size: 2rem;
    }
    .service-content-box {
      padding: 1.5rem;
    }
    .service-cta {
      padding: 2rem 1.5rem;
    }
  }
</style>
