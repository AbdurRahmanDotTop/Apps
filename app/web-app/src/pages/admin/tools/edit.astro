---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import { env } from "cloudflare:workers";

const session = Astro.cookies.get('admin_session')?.value;
if (!session) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
const url = new URL(Astro.request.url);
const id = url.searchParams.get('id');

if (!id) {
  return Astro.redirect('/admin/tools');
}

let app: any = null;
let errorMsg = '';
let categories: any[] = [];

try {
  categories = (await db.prepare("SELECT * FROM tool_categories").all()).results;
} catch (err) {}

try {
  app = await db.prepare("SELECT * FROM tools WHERE id = ?").bind(id).first();
} catch (e) {
  console.error("Failed to fetch Tool", e);
}

if (!app) {
  return Astro.redirect('/admin/tools');
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = data.get('name')?.toString().trim();
    const slug = data.get('slug')?.toString().trim();
    const category_id = data.get('category_id') || null;
    const logo_url = data.get('logo_url')?.toString().trim() || null;
    const banner_url = data.get('banner_url')?.toString().trim() || null;
    const description = data.get('description')?.toString().trim();
    const web_url = data.get('web_url')?.toString().trim() || null;
    const is_featured = data.get('is_featured') === 'on' ? 1 : 0;
    const status = data.get('status')?.toString().trim() || 'draft';

    if (name && slug) {
      await db.prepare(`
        UPDATE tools 
        SET category_id = ?, name = ?, slug = ?, logo_url = ?, banner_url = ?, description = ?, web_url = ?, is_featured = ?, status = ?, updated_at = CURRENT_TIMESTAMP
        WHERE id = ?
      `).bind(category_id, name, slug, logo_url, banner_url, description, web_url, is_featured, status, id).run();
      
      return Astro.redirect('/admin/tools');
    } else {
      errorMsg = 'Name and Slug are required.';
    }
  } catch (e: any) {
    if (e.message?.includes('UNIQUE constraint failed')) {
      errorMsg = 'A Tool with this slug already exists.';
    } else {
      errorMsg = 'Failed to update Tool. Please try again.';
    }
    console.error("Update Tool Error:", e);
  }
}
---

<AdminLayout title={`Edit Tool: ${app.name}`}>
  <div class="page-header">
    <a href="/admin/tools" class="back-link">← Back to Tools</a>
  </div>

  <Card>
    {errorMsg && <div class="error-banner">{errorMsg}</div>}
    
    <form method="POST" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label for="name">App Name *</label>
          <input type="text" id="name" name="name" required value={app.name} />
        </div>
        <div class="form-group">
          <label for="slug">URL Slug *</label>
          <input type="text" id="slug" name="slug" required value={app.slug} />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="category_id">Category</label>
          <select id="category_id" name="category_id">
            <option value="">No Category</option>
            {categories.map(cat => (
              <option value={cat.id} selected={app.category_id === cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="logo_url">Logo URL</label>
          <input type="url" id="logo_url" name="logo_url" value={app.logo_url || ''} />
        </div>
        <div class="form-group">
          <label for="banner_url">Banner Image URL</label>
          <input type="url" id="banner_url" name="banner_url" value={app.banner_url || ''} />
        </div>
      </div>

      <div class="form-group">
        <label for="web_url">Tool URL</label>
        <input type="url" id="web_url" name="web_url" value={app.web_url || ''} />
      </div>

      <div class="form-group">
        <label for="description">Description (Rich Text)</label>
        <div id="editor-container" style="height: 300px; background: #fff; border-radius: 0 0 8px 8px; font-family: inherit;" set:html={app.description || ''}></div>
        <input type="hidden" id="description" name="description" value={app.description || ''} />
      </div>

      <div class="form-row">
        <div class="form-group checkbox-group">
          <input type="checkbox" id="is_featured" name="is_featured" checked={app.is_featured === 1} />
          <label for="is_featured">Feature on Homepage</label>
        </div>
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="draft" selected={app.status === 'draft'}>Draft (Hidden)</option>
            <option value="published" selected={app.status === 'published'}>Published</option>
          </select>
        </div>
      </div>

      <div class="form-actions">
        <Button type="submit" variant="primary">Save Changes</Button>
      </div>
    </form>
  </Card>
</AdminLayout>

<!-- Quill Rich Text Editor -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof Quill !== 'undefined') {
      const quill = new Quill('#editor-container', {
        theme: 'snow',
        placeholder: 'Detailed description of the Tool...',
        modules: {
          toolbar: [
            [{ 'header': [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            ['link', 'image', 'video'],
            ['clean']
          ]
        }
      });

      const form = document.querySelector('.admin-form');
      const descInput = document.querySelector('#description');
      
      if(form && descInput) {
        form.addEventListener('submit', () => {
          // Get HTML content. If empty or just `<p><br></p>`, clear it.
          let html = quill.root.innerHTML;
          if(html === '<p><br></p>') html = '';
          descInput.value = html;
        });
      }
    }
  });
</script>

<style>
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 1.5rem;
    display: inline-block;
  }
  .back-link:hover {
    color: var(--primary-color);
  }
  .error-banner {
    background: #fee2e2;
    color: #991b1b;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }
  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-group label {
    font-weight: 600;
    color: var(--text-color);
  }
  .form-group input[type="text"],
  .form-group input[type="url"],
  .form-group select,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--border-color, rgba(33, 33, 33, 0.2));
    background-color: #fff;
    color: var(--text-color, #212121);
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb), 0.1);
  }
  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }
  .checkbox-group input {
    width: 20px;
    height: 20px;
  }
  .form-actions {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
  }
  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

