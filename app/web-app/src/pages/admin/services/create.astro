---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import { env } from 'cloudflare:workers';

const db = env.DB;
let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = data.get('name')?.toString().trim();
    const slug = data.get('slug')?.toString().trim();
    const icon = data.get('icon')?.toString().trim();
    const description = data.get('description')?.toString().trim();
    const content = data.get('content')?.toString().trim();
    const status = data.get('status')?.toString().trim();

    if (name && slug) {
      await db.prepare("INSERT INTO services (name, slug, icon, description, content, status) VALUES (?, ?, ?, ?, ?, ?)")
        .bind(name, slug, icon, description, content, status).run();
      return Astro.redirect('/admin/services');
    } else {
      errorMsg = 'Name and slug are required.';
    }
  } catch (err: any) {
    errorMsg = err.message || 'Error creating service.';
  }
}
---

<AdminLayout title="Add Service">
  <div class="admin-header" style="margin-bottom: 2rem;">
    <a href="/admin/services" style="color: var(--text-secondary); text-decoration: none; margin-bottom: 1rem; display: inline-block;">&larr; Back to Services</a>
    <h1>Add New Service</h1>
  </div>

  <Card>
    {errorMsg && <div style="color: red; margin-bottom: 1rem;">{errorMsg}</div>}

    <form method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Name</label>
        <input type="text" name="name" required style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>
      
      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Slug</label>
        <input type="text" name="slug" required style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Icon (Boxicons class, e.g. bx-mobile)</label>
        <input type="text" name="icon" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Short Description (for cards)</label>
        <textarea name="description" rows="2" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;"></textarea>
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Page Content (Detailed information, accepts markdown/HTML)</label>
        <textarea name="content" rows="10" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;"></textarea>
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Status</label>
        <select name="status" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;">
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>

      <Button type="submit" variant="primary" style="margin-top: 1rem; width: fit-content;">Save Service</Button>
    </form>
  </Card>
</AdminLayout>
