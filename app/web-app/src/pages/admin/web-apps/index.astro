---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Badge from '../../../components/ui/Badge.astro';
import { env } from "cloudflare:workers";

const session = Astro.cookies.get('admin_session')?.value;
if (!session) {
  return Astro.redirect('/admin/login');
}

const db = env.DB;
let webApps = [];

try {
  const result = await db.prepare(`
    SELECT * FROM web_apps
    ORDER BY created_at DESC
  `).all();
  webApps = result.results;
} catch (e) {
  console.error("Failed to fetch web apps for admin", e);
}
---

<AdminLayout title="Manage Web Apps">
  <div class="page-header">
    <p>Manage web application listings, edit details, and configure URLs.</p>
    <Button href="/admin/web-apps/create" variant="primary">Add New Web App</Button>
  </div>
  
  <Card>
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Last Updated</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {webApps.map(app => (
            <tr>
              <td>{app.id}</td>
              <td>
                <div class="app-info">
                  {app.logo_url && <img src={app.logo_url} alt={`${app.name} logo`} class="app-logo-small" />}
                  <span>{app.name}</span>
                </div>
              </td>
              <td>
                <Badge variant={app.status === 'published' ? 'success' : 'default'}>
                  {app.status.toUpperCase()}
                </Badge>
              </td>
              <td>
                <Badge variant={app.is_featured === 1 ? 'primary' : 'default'}>
                  {app.is_featured === 1 ? 'Yes' : 'No'}
                </Badge>
              </td>
              <td>{new Date(app.updated_at).toLocaleDateString()}</td>
              <td class="actions">
                <Button href={`/admin/web-apps/edit?id=${app.id}`} variant="outline" size="small">Edit</Button>
                <form action={`/api/admin/web-apps/${app.id}/delete`} method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this web app?');">
                  <Button type="submit" variant="danger" size="small">Delete</Button>
                </form>
              </td>
            </tr>
          ))}
          {webApps.length === 0 && (
            <tr>
              <td colspan="6" class="text-center" style="padding: 2rem;">No web apps found. Add your first web app!</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </Card>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .page-header p {
    color: var(--text-muted);
    margin: 0;
  }
  .app-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .app-logo-small {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
  }
  .admin-table th, .admin-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }
  .admin-table th {
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .text-center {
    text-align: center;
  }
</style>
