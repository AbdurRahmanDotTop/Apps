---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import { env } from 'cloudflare:workers';

const db = env.DB;
const id = Astro.url.searchParams.get('id');
let errorMsg = '';
let category: any = null;

if (!id) return Astro.redirect('/admin/categories');

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = data.get('name')?.toString().trim();
    const slug = data.get('slug')?.toString().trim();
    const icon = data.get('icon')?.toString().trim();
    const description = data.get('description')?.toString().trim();
    const status = data.get('status')?.toString().trim();

    if (name && slug) {
      await db.prepare("UPDATE tool_categories SET name = ?, slug = ?, icon = ?, description = ?, status = ? WHERE id = ?")
        .bind(name, slug, icon, description, status, id).run();
      return Astro.redirect('/admin/tool-categories');
    } else {
      errorMsg = 'Name and slug are required.';
    }
  } catch (err: any) {
    errorMsg = err.message || 'Error updating category.';
  }
}

try {
  category = await db.prepare("SELECT * FROM tool_categories WHERE id = ?").bind(id).first();
  if (!category) return Astro.redirect('/admin/tool-categories');
} catch (err) {
  return Astro.redirect('/admin/tool-categories');
}
---

<AdminLayout title="Edit Category">
  <div class="admin-header" style="margin-bottom: 2rem;">
    <a href="/admin/tool-categories" style="color: var(--text-secondary); text-decoration: none; margin-bottom: 1rem; display: inline-block;">&larr; Back to Tool Categories</a>
    <h1>Edit Category</h1>
  </div>

  <Card>
    {errorMsg && <div style="color: red; margin-bottom: 1rem;">{errorMsg}</div>}

    <form method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Name</label>
        <input type="text" name="name" value={category.name} required style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>
      
      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Slug</label>
        <input type="text" name="slug" value={category.slug} required style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Icon (Boxicons class)</label>
        <input type="text" name="icon" value={category.icon} style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;" />
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Description</label>
        <textarea name="description" rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;">{category.description}</textarea>
      </div>

      <div class="form-group">
        <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Status</label>
        <select name="status" style="width: 100%; padding: 0.75rem; border: 1px solid rgba(33,33,33,0.2); border-radius: 4px;">
          <option value="active" selected={category.status === 'active'}>Active</option>
          <option value="inactive" selected={category.status === 'inactive'}>Inactive</option>
        </select>
      </div>

      <Button type="submit" variant="primary" style="margin-top: 1rem; width: fit-content;">Update Category</Button>
    </form>
  </Card>
</AdminLayout>
